---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  type = 'website',
  publishedTime,
} = Astro.props;

const SITE = 'Ayush Bhalerao';
const TWITTER = '@i_u_sh';

const DEFAULT_DESCRIPTION =
  'ayush bhalerao — entc student building small things for the web. projects, write-ups, and the occasional breakdown.';

const description = Astro.props.description?.trim() || DEFAULT_DESCRIPTION;
const image = Astro.props.image?.trim() || '/assets/og.png';

const absolute = (path: string) =>
  new URL(path, Astro.site ?? Astro.url).href;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = absolute(image);

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        url: canonical,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        author: {
          '@type': 'Person',
          name: SITE,
          url: absolute('/'),
          sameAs: [
            'https://github.com/ahhyoushh',
            'https://linkedin.com/in/ayushbhalerao',
            `https://x.com/i_u_sh`,
          ],
        },
        ...(publishedTime ? { datePublished: publishedTime } : {}),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE,
        description,
        url: absolute('/'),
      };
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER} />
    <meta name="twitter:creator" content={TWITTER} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#0a0a0a" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />

    <style is:inline>
      body {
        opacity: 0;
        transition: opacity 0.4s ease-in-out;
      }

      body.loaded {
        opacity: 1;
      }
    </style>
  </head>

  <body>
    <slot name="nav">
      <nav>
        <div class="nav-brand">$ ayush</div>
        <ul class="nav-links">
          <li><a href="#about">about</a></li>
          <li><a href="/projects">projects</a></li>
          <li><a href="/blogs">blogs</a></li>
        </ul>
        <div class="nav-social">
          <a href="https://github.com/ahhyoushh" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
          <a href="https://linkedin.com/in/ayushbhalerao" target="_blank" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
          <a href="mailto:iush.wrk@gmail.com" title="Email"><i class="fas fa-envelope"></i></a>
        </div>
      </nav>
    </slot>

    <slot />

    <slot name="footer">
      <footer>
        <p class="footer-text">© 2025 ayush bhalerao</p>
      </footer>
    </slot>

    <script data-goatcounter="https://ayush.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

    <script>
      window.addEventListener("load", () => {
        document.body.classList.add("loaded");
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".md-content pre.astro-code").forEach((pre) => {
          const code = pre.querySelector("code");
          if (!code) return;

          const langClass = [...code.classList].find((c) => c.startsWith("language-"));
          const lang = langClass ? langClass.replace("language-", "") : "";

          const text = code.textContent;
          const lines = text.split("\n");
          let collapsedByDefault = false;
          const collapseMarker = /^\s*(\/\/|#|--|<!--)\s*@collapsed\s*(-->)?\s*$/;
          if (lines.length > 0 && collapseMarker.test(lines[0])) {
            collapsedByDefault = true;
            code.textContent = lines.slice(1).join("\n").replace(/^\n/, "");
          }

          const wrapper = document.createElement("div");
          wrapper.className = "code-block-wrapper";
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const header = document.createElement("div");
          header.className = "code-block-header";

          const langLabel = document.createElement("span");
          langLabel.className = "code-block-lang";
          langLabel.textContent = lang || "code";
          header.appendChild(langLabel);

          const actions = document.createElement("div");
          actions.className = "code-block-actions";

          const collapseBtn = document.createElement("button");
          collapseBtn.className = "collapse-btn";
          collapseBtn.textContent = collapsedByDefault ? "+" : "−";
          collapseBtn.title = collapsedByDefault ? "Expand" : "Collapse";
          actions.appendChild(collapseBtn);

          const copyBtn = document.createElement("button");
          copyBtn.className = "copy-btn";
          copyBtn.textContent = "copy";
          copyBtn.addEventListener("click", async () => {
            try {
              const codeText = code.textContent;
              await navigator.clipboard.writeText(codeText);
              copyBtn.textContent = "copied!";
              copyBtn.classList.add("copied");
              setTimeout(() => {
                copyBtn.textContent = "copy";
                copyBtn.classList.remove("copied");
              }, 2000);
            } catch {
              copyBtn.textContent = "failed";
            }
          });
          actions.appendChild(copyBtn);

          header.appendChild(actions);
          wrapper.insertBefore(header, pre);

          if (collapsedByDefault) {
            wrapper.classList.add("collapsed");
          }

          collapseBtn.addEventListener("click", () => {
            wrapper.classList.toggle("collapsed");
            const isCollapsed = wrapper.classList.contains("collapsed");
            collapseBtn.textContent = isCollapsed ? "+" : "−";
            collapseBtn.title = isCollapsed ? "Expand" : "Collapse";
          });
        });
      });
    </script>
  </body>
</html>
