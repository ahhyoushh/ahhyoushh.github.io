---
import Base from './Base.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  publishedTime?: string;
}
const { title, description, image, publishedTime } = Astro.props;
---
<Base
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={publishedTime}
>
  <Fragment slot="nav">
    <nav>
      <div class="nav-brand"><a href="/">$ ayush</a></div>
      <a href="/blogs" class="nav-back">← blogs</a>
    </nav>
  </Fragment>

  <section class="md-content">
    <slot />
  </section>
</Base>
