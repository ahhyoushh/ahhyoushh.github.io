---
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import projects from '../../data/projects.json';
---
<Base
  title="projects // Ayush Bhalerao"
  description="every project i've shipped — prediction markets, local-ai tools, terminal toys, and a few things that stayed in the repo."
>
  <Fragment slot="nav">
    <nav>
      <div class="nav-brand"><a href="/">$ ayush</a></div>
      <ul class="nav-links">
        <li><a href="/#about">about</a></li>
        <li><a href="/projects">projects</a></li>
        <li><a href="/blogs">blogs</a></li>
      </ul>
      <div class="nav-social">
        <a href="https://github.com/ahhyoushh" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
        <a href="https://linkedin.com/in/ayushbhalerao" target="_blank" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
        <a href="mailto:iush.wrk@gmail.com" title="Email"><i class="fas fa-envelope"></i></a>
      </div>
    </nav>
  </Fragment>

  <section class="page-top">
    <a class="back-btn" href="/">&larr; back home</a>
  </section>

  <section class="projects" style="border-top: none">
    <h2 class="section-title">projects</h2>
    <ul class="project-list" id="project-list-all">
      {
        projects.map(p => {
          const href = p.link;
          const external = href.startsWith("http");
          return (
            <li class="project-item">
              <div class="project-meta-row">
                <div class="project-title">
                  <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{p.title}</a>
                </div>
                {p.date ? <span class="project-date">{p.date}</span> : null}
              </div>
              <p class="project-desc" set:html={p.description} />
              {p.tags ? (
                <div class="project-tags">
                  {p.tags.map(t => (
                    <span class={`tag${t === 'deprecated' ? ' tag-deprecated' : ''}`}>{t}</span>
                  ))}
                </div>
              ) : null}
            </li>
          );
        })
      }
    </ul>
  </section>

  <Fragment slot="footer">
    <SiteFooter webring><a href="/">&larr; back home</a></SiteFooter>
  </Fragment>
</Base>
