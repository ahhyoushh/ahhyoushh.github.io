---
import threadlockedPng from '../assets/threadlocked.png';
import threadlockedWebp from '../assets/threadlocked.webp';

const pngSrc = threadlockedPng.src;
const webpSrc = threadlockedWebp.src;

const RING = 'https://ring.seggs.lol';
const HANDLE = 'ayush';
const prev = `${RING}/redirect?from=${HANDLE}&dir=prev`;
const next = `${RING}/redirect?from=${HANDLE}&dir=next`;

interface Props {
  heading?: boolean;
}

const { heading = true } = Astro.props;
---
<section class="webring" aria-label="webring">
  {heading && <h2>webring</h2>}
  <div class="webring-row">
    <a href={prev} rel="nofollow noopener" aria-label="previous webring site">&larr;</a>
    <a href={RING} rel="nofollow noopener">
      <picture>
        <source srcset={webpSrc} type="image/webp" />
        <img
          src={pngSrc}
          alt="threadlocked webring badge"
          width="88"
          height="31"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </a>
    <a href={next} rel="nofollow noopener" aria-label="next webring site">&rarr;</a>
  </div>
</section>
